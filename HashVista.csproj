<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>HashVista</AssemblyName><Product>HashVista — Hash &amp; Media Scanner</Product><Version>1.3.0</Version><PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap><ApplicationManifest>app.manifest</ApplicationManifest>
    <IncludeMediaTools Condition="'$(IncludeMediaTools)' == ''">true</IncludeMediaTools><RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup><Compile Include="src\**\*.cs"/><PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13"/><PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/></ItemGroup>
  <ItemGroup><Content Include="dependencies\**\*" Condition="'$(IncludeMediaTools)' == 'true'"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content></ItemGroup>
</Project>


